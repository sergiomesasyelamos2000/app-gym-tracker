<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/workout_live_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/workout_live_card_bg"
  android:gravity="center_vertical"
  android:minHeight="56dp"
  android:orientation="horizontal"
  android:paddingStart="14dp"
  android:paddingTop="10dp"
  android:paddingEnd="14dp"
  android:paddingBottom="10dp">

  <ImageView
    android:id="@+id/workout_live_exercise_image"
    android:layout_width="36dp"
    android:layout_height="36dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/workout_live_image_bg"
    android:padding="7dp"
    android:scaleType="centerInside"
    android:src="@drawable/ic_workout_live_barbell" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/workout_live_exercise_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#1C1B1F"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/workout_live_next_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="#49454F"
      android:textSize="11sp" />
  </LinearLayout>

  <Chronometer
    android:id="@+id/workout_live_primary_time"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:format="%s"
    android:textColor="#5F6368"
    android:textSize="14sp" />
</LinearLayout>
