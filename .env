# Deja EXPO_PUBLIC_API_URL comentado en local para que environment.ts
# elija solo: emulador Android -> 10.0.2.2 | dispositivo fisico -> LOCAL_IP
#EXPO_PUBLIC_API_URL=https://api-gym-tracker.onrender.com/api
#EXPO_PUBLIC_API_URL_ANDROID=https://api-gym-tracker.onrender.com/api

# Si usas emulador Android (npm run android), descomenta esta linea:
EXPO_PUBLIC_API_URL_ANDROID=http://10.0.2.2:3000/api

# Si usas movil fisico en la misma WiFi, comenta la de arriba y usa:
#EXPO_PUBLIC_API_URL_ANDROID=http://192.168.1.133:3000/api
#EXPO_PUBLIC_API_URL=http://192.168.1.133:3000/api

