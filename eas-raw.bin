{"name":"worker","pid":199,"phase":"READ_APP_CONFIG","buildId":"32bdc9d5-306d-4c1e-a860-361a2463ff1f","level":30,"msg":"{\n  \"name\": \"EvoFit\",\n  \"slug\": \"app\",\n  \"platforms\": [\n    \"ios\",\n    \"android\",\n    \"web\"\n  ],\n  \"version\": \"1.0.1\",\n  \"orientation\": \"portrait\",\n  \"icon\": \"./assets/icon.png\",\n  \"userInterfaceStyle\": \"automatic\",\n  \"newArchEnabled\": true,\n  \"splash\": {\n    \"image\": \"./assets/splash-icon.png\",\n    \"resizeMode\": \"contain\",\n    \"backgroundColor\": \"#ffffff\"\n  },\n  \"scheme\": [\n    \"com.smy862.app\",\n    \"com.googleusercontent.apps.1029378599483-55i89a23olo9k8pvidrveh2pkfn1cuni\"\n  ],\n  \"notification\": {\n    \"icon\": \"./assets/icon.png\"\n  },\n  \"ios\": {\n    \"icon\": \"./assets/ios-icon.png\",\n    \"supportsTablet\": true,\n    \"usesAppleSignIn\": true,\n    \"bundleIdentifier\": \"com.smy862.app\",\n    \"buildNumber\": \"71\",\n    \"infoPlist\": {\n      \"UIViewControllerBasedStatusBarAppearance\": false,\n      \"NSPhotoLibraryUsageDescription\": \"EvoFit necesita acceso a tu fototeca para que puedas, por ejemplo, elegir una foto para tu perfil o subir una imagen de una comida para estimar calorías y macronutrientes y guardarla en tu diario nutricional.\",\n      \"NSCameraUsageDescription\": \"EvoFit necesita acceso a la cámara para escanear códigos de barras de productos alimenticios y para fotografiar comidas, estimar calorías y macronutrientes, y guardarlas en tu diario nutricional.\",\n      \"NSHealthShareUsageDescription\": \"EvoFit lee de Apple Salud tu frecuencia cardiaca y energía activa durante el entrenamiento, y tu sueño y pasos para consejos de descanso.\",\n      \"NSHealthUpdateUsageDescription\": \"EvoFit puede guardar en Apple Salud el entrenamiento completado y las calorías activas de la sesión, si activas esa opción.\",\n      \"ITSAppUsesNonExemptEncryption\": false\n    }\n  },\n  \"android\": {\n    \"usesCleartextTraffic\": true,\n    \"adaptiveIcon\": {\n      \"foregroundImage\": \"./assets/adaptive-icon.png\",\n      \"backgroundColor\": \"#5B21B6\"\n    },\n    \"edgeToEdgeEnabled\": true,\n    \"package\": \"com.smy862.app\",\n    \"versionCode\": 1,\n    \"permissions\": [\n      \"android.permission.CAMERA\",\n      \"android.permission.POST_NOTIFICATIONS\",\n      \"android.permission.FOREGROUND_SERVICE\",\n      \"android.permission.FOREGROUND_SERVICE_SPECIAL_USE\",\n      \"android.permission.health.READ_HEART_RATE\",\n      \"android.permission.health.READ_ACTIVE_CALORIES_BURNED\",\n      \"android.permission.health.READ_SLEEP\",\n      \"android.permission.health.READ_STEPS\",\n      \"android.permission.health.WRITE_EXERCISE\",\n      \"android.permission.health.WRITE_ACTIVE_CALORIES_BURNED\"\n    ]\n  },\n  \"web\": {\n    \"favicon\": \"./assets/favicon.png\",\n    \"bundler\": \"metro\"\n  },\n  \"plugins\": [\n    [\n      \"@react-native-google-signin/google-signin\",\n      {\n        \"iosUrlScheme\": \"com.googleusercontent.apps.1029378599483-9b2ho2kkigj6foqvjuji2lslunvrm3bv\"\n      }\n    ],\n    [\n      \"expo-camera\",\n      {\n        \"cameraPermission\": \"EvoFit necesita acceso a la cámara para escanear códigos de barras de productos alimenticios y para fotografiar comidas, estimar calorías y macronutrientes, y guardarlas en tu diario nutricional.\",\n        \"recordAudioAndroid\": false\n      }\n    ],\n    [\n      \"expo-build-properties\",\n      {\n        \"ios\": {\n          \"extraPods\": [\n            {\n              \"name\": \"GoogleUtilities\",\n              \"modular_headers\": true\n            },\n            {\n              \"name\": \"RecaptchaInterop\",\n              \"modular_headers\": true\n            },\n            {\n              \"name\": \"AppCheckCore\",\n              \"version\": \"11.2.0\"\n            }\n          ]\n        },\n        \"android\": {\n          \"minSdkVersion\": 26\n        }\n      }\n    ],\n    [\n      \"apple-health\",\n      {\n        \"healthSharePermission\": \"EvoFit lee de Apple Salud tu frecuencia cardiaca y energía activa durante el entrenamiento, y tu sueño y pasos para consejos de descanso.\",\n        \"healthUpdatePermission\": \"EvoFit puede guardar en Apple Salud el entrenamiento completado y las calorías activas de la sesión, si activas esa opción.\",\n        \"backgroundDelivery\": false,\n        \"healthKitRequired\": false\n      }\n    ],\n    \"react-native-health-connect\",\n    \"./plugins/withHealthUsageStrings\",\n    \"./plugins/withWorkoutLiveActivity\",\n    \"./plugins/withIosPodFixes\",\n    \"@react-native-community/datetimepicker\"\n  ],\n  \"extra\": {\n    \"eas\": {\n      \"projectId\": \"59890898-088b-402b-bc22-b15ec51d1c17\",\n      \"build\": {\n        \"experimental\": {\n          \"ios\": {\n            \"appExtensions\": [\n              {\n                \"targetName\": \"WorkoutLiveActivity\",\n                \"bundleIdentifier\": \"com.smy862.app.WorkoutLiveActivity\",\n                \"entitlements\": {\n                  \"com.apple.security.application-groups\": [\n                    \"group.com.smy862.app\"\n                  ]\n                }\n              }\n            ]\n          }\n        }\n      }\n    },\n    \"enableAndroidPush\": false,\n    \"appleIap\": {\n      \"monthlyProductId\": \"com.smy862.app.premium.monthly.v2\",\n      \"yearlyProductId\": \"com.smy862.app.premium.yearly.v2\",\n      \"lifetimeProductId\": \"com.smy862.app.premium.lifetime\"\n    }\n  },\n  \"owner\": \"smy862\",\n  \"sdkVersion\": \"54.0.0\"\n}","time":"2026-10-09T06:12:55.297Z","v":0,"logId":"01a11f4b-0f81-7b10-921c-22b5f24167cb"}
